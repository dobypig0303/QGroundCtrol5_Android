 #include <QtQml>
 #include <QQmlEngine>
 
+// QGC 4.0.11 never translates the strings that come from the *.Fact.json files, so the fly
+// view instrument panel (and every other place displaying a Fact name) stays English even for
+// locales whose .ts file is complete.
+//
+// Translating them while loading the JSON does NOT work: the vehicle fact groups - including
+// the offline editing vehicle - are constructed by the toolbox before QGCApplication installs
+// the QTranslator, so the lookup misses and the English text is baked into the metadata.
+// Translating here, at display time, always happens after the translator is in place.
+static QString _translateFactJsonString(const QString& source)
+{
+    return QCoreApplication::translate("QGCJson", source.toUtf8().constData());
+}
